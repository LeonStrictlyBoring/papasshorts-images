rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Artikel-Uploads: nur der eigene User darf schreiben (max. 10 MB, nur Bilder), alle eingeloggten User dürfen lesen
    match /artikel/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size < 10 * 1024 * 1024;
    }

    // KI-generierte Bilder (Models, Settings, Shootings): nur lesen für eingeloggte User
    // Schreiben erfolgt ausschließlich über Cloud Functions (Admin SDK, umgeht Rules)
    match /generated/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
