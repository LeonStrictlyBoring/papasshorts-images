rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdminOrDeveloper() {
      return isSignedIn() && userDocExists() && userRole() in ['admin', 'developer'];
    }

    function isDeveloper() {
      return isSignedIn() && userDocExists() && userRole() == 'developer';
    }

    // users collection
    match /users/{uid} {
      // own profile: read only
      allow read: if isSignedIn() && request.auth.uid == uid;

      // admin/developer: read and write all profiles
      allow read, write: if isAdminOrDeveloper();

      // self-registration: create own document with role:user and status:pending
      allow create: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.data.role == 'user'
        && request.resource.data.status == 'pending';
    }

    // prompts collection: developer read/write only
    match /prompts/{promptId} {
      allow read, write: if isDeveloper();
    }

    // errorLogs collection: developer read only, write via Cloud Functions (Admin SDK)
    match /errorLogs/{logId} {
      allow read: if isDeveloper();
      allow write: if false;
    }

    // shootings collection
    match /shootings/{shootingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']);
      allow write: if isAdminOrDeveloper();
    }

    // artikel collection
    match /artikel/{artikelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']);
      allow write: if isAdminOrDeveloper();
    }

    // settings collection
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']);
      allow write: if isAdminOrDeveloper();
    }

    // rateLimits collection: nur via Cloud Functions (Admin SDK) beschreibbar
    match /rateLimits/{userId} {
      allow read, write: if false;
    }

    // models collection
    match /models/{modelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // users may only set the archived flag (soft delete)
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']);
      allow write: if isAdminOrDeveloper();
    }
  }
}
